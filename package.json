{
  "name": "mordoc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getmordoc/mordoc.git"
  },
  "homepage": "https://mordoc.dev",
  "bugs": {
    "url": "https://github.com/getmordoc/mordoc/issues"
  },
  "version": "2.2.0",
  "description": "A modern documentation site generator powered by Vite, React, and Markdoc.",
  "type": "module",
  "files": [
    "dist/",
    "bin/",
    "src/app/"
  ],
  "bin": {
    "mordoc": "bin/cli.js"
  },
  "engines": {
    "node": ">=24.18.1"
  },
  "author": "The Mordoc Authors",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "pretest:build": "npm run build",
    "test:build": "node --test \"test/build/**/*.test.ts\"",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "check": "biome ci --error-on-warnings",
    "fix": "biome check --write",
    "test": "npm run check && npm run test:build && npm run test:e2e",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "documentation-site-generator",
    "static-site-generator",
    "mordoc"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@markdoc/markdoc": "^0.5.13",
    "@redocly/openapi-core": "^2.79.0",
    "@vitejs/plugin-react": "^6.1.1",
    "js-yaml": "^5.4.2",
    "pagefind": "^1.5.2",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "fsevents": false
  }
}
